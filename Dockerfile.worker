FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install -U pip setuptools wheel

# This will bring numpy>=2.0.2 (as required by your cell2mol branch)
RUN pip install "cell2mol @ git+https://github.com/lcmd-epfl/cell2mol.git@feat/pydantic"

# Lightweight API server so your web container can call it
RUN pip install fastapi uvicorn

COPY worker_api.py /app/worker_api.py

EXPOSE 8000
CMD ["uvicorn", "worker_api:app", "--host", "0.0.0.0", "--port", "8000"]

